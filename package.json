{
  "name": "furevrnac",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Furevrnac — the forever almanac. Download once, play forever.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:native": "VITE_BASE=native vite build",
    "sync:android": "npm run build:native && npx cap sync android",
    "sync:ios": "npm run build:native && npx cap sync ios"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3"
  }
}
